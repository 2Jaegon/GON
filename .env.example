# ASO Web Environment Configuration Template
NODE_ENV=development
PORT=4000
HOST=127.0.0.1

# Database & Cache
DATABASE_URL=postgresql://aso:aso_dev_password@localhost:5432/aso_dev
REDIS_URL=redis://localhost:6379

# Web & API URLs
PUBLIC_APP_URL=http://localhost:3000
API_ORIGIN=http://localhost:4000
WEB_ORIGIN=http://localhost:3000

# Security Secrets (Must be at least 32 characters in production)
SESSION_SECRET=dev-session-secret-at-least-32-chars-long-example
SECRETS_ENCRYPTION_KEY=dGVzdC1lbmNyeXB0aW9uLWtleS0zMi1ieXRlcy1sb25nIQ==

# Local Artifact Storage (MinIO / S3)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=aso-artifacts
OBJECT_STORAGE_ACCESS_KEY=localdev
OBJECT_STORAGE_SECRET_KEY=localdev-only-password

# Feature Gates
ENABLE_CLOUD_SANDBOX=false
ENABLE_PARTNER_OAUTH=false
ENABLE_BILLING=false
ENABLE_ECC_SPECIALIST=false

