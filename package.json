{
  "name": "gon",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "bin": {
    "gon": "cli/dist/cli.js",
    "aso-runner": "apps/local-runner/dist/cli.js"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:contracts": "tsc -p packages/contracts",
    "build:security": "tsc -p packages/security",
    "build:database": "tsc -p packages/database",
    "build:core": "tsc -p packages/aso-core",
    "build:execution": "tsc -p packages/execution-protocol",
    "build:providers": "tsc -p packages/provider-adapters",
    "build:api": "tsc -p apps/api",
    "build:runner": "tsc -p apps/local-runner",
    "build:web": "tsc -p apps/web",
    "build:worker": "tsc -p apps/worker",
    "build:cli": "tsc -p cli",
    "build": "npm run build:contracts && npm run build:security && npm run build:database && npm run build:core && npm run build:execution && npm run build:providers && npm run build:api && npm run build:runner && npm run build:web && npm run build:worker && npm run build:cli",
    "typecheck": "npm run build",
    "dev": "node scripts/start-all.js",
    "start": "node scripts/start-all.js",
    "start:api": "node apps/api/dist/index.js",
    "start:web": "node apps/web/dist/server.js",
    "start:runner": "node apps/local-runner/dist/cli.js start",
    "test:viewer": "node --test \"tests/**/*.test.mjs\"",
    "test:cli": "vitest run tests/cli",
    "test:aso-web": "vitest run tests/aso-web",
    "test": "npm run test:viewer && vitest run"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.23.1",
    "bcryptjs": "^3.0.3",
    "commander": "^13.1.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "ws": "^8.22.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/ws": "^8.18.2",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
